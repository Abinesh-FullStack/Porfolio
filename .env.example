# Copy this file to .env and fill in your Supabase project values.
# These are bundled into the public website, so ONLY use the publishable (anon) key here.
# Never put a secret / service_role key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
